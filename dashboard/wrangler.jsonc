{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cokacremote-monitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cokacremote-monitor",
      "database_id": "09dc0c9e-2746-4f89-bda6-61491cc67963"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "OFFLINE_AFTER_SECONDS": "120"
  }
}
